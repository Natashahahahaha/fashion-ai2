# Copy to .env and edit. Real environment variables take precedence over this file.
# Every value is optional; the defaults are shown.

# auto | cpu | cuda | cuda:0 | mps   (auto = CUDA if available, else CPU)
DEVICE=auto

# YOLO-World weights. A bare file name is looked up in / downloaded to CHECKPOINT_DIR.
DETECTOR_MODEL=yolov8s-worldv2.pt
# Regions scoring at least this are auto-accepted; lower ones are shown flagged for review
CONFIDENCE_THRESHOLD=0.25
# Regions below this are not shown at all
DETECTION_FLOOR=0.15
IOU_THRESHOLD=0.45

# Hugging Face CLIP model. Changing it makes existing embeddings "stale"
# (Diagnostics page -> "Re-embed affected items").
CLIP_MODEL=openai/clip-vit-base-patch32

DATA_DIR=data
CHECKPOINT_DIR=checkpoints

# auto: use checkpoints/compatibility_model.pt if present and compatible, else baseline
USE_LEARNED_MODEL=auto

MAX_UPLOAD_MB=15

# How strongly a requested style/occasion re-ranks outfits
WEIGHT_CONTEXT=0.10
# Weights of the heuristic BASELINE used only for comparison in training/evaluation.
# The app ranks with the fitted combiner (src/recommendation/ranker_model.json).
WEIGHT_VISUAL=0.35
WEIGHT_COLOR=0.20
WEIGHT_STYLE=0.20
WEIGHT_CATEGORY=0.15
